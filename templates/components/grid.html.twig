{% if this.condition %}
    {% set columns = this.normalizedColumns %}
    {% set controller = this.backend == 'ux'
        ? survos_stimulus('simple-datatables-bundle', 'ux')
        : this.stimulusController %}
    {% set values = this.backend == 'ux' ? {view: this.uxOptions} : {
        search: this.search,
        perPage: this.perPage,
        remoteUrl: this.remoteUrl,
        columns: this.columns,
        info: this.info,
    } %}
    <table {% if this.tableId %}id="{{ this.tableId }}"{% endif %}
        class="table table-striped {{ this.tableClasses }}"
        {% if this.useDatatables and controller %}{{ stimulus_controller(controller, values) }}{% endif %}>
        {% if not this.remoteUrl %}
            <thead>
            <tr>
                {% for c in columns %}
                    <th data-column-name="{{ c.name }}" class="
                        {{ c.inSearchPane ? 'in-search-pane' }}
                        "
                    >
                        {{ this.trans ? c.title|trans : c.title }}
                    </th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for idx, row in this.data %}
                <tr class="align-top">
                    {% for c in columns %}
                    <td>
                        {% set templateName = c.block|default(c.twigTemplate)|default(c.name) %}

                        {% if block(templateName) is defined %}
                            {% with {field_name: c.name, row: row, idx: idx, column: c, c:c } %}
                                {{ block(templateName) }}
                            {% endwith %}
                        {% else %}
                            {% if c.twigTemplate %}
                                <span class="text-danger">{{ templateName }} is not defined.</span>
                            {% endif %}
                            {% set label = attribute(row, c.name)|default() %}
                            {% if label is iterable %}
                                {% set label = label|length %}
                            {% endif %}
                            {% if c.translateValue %}
                                {% set label = c.domain ? label|trans(domain=c.domain) : label|trans %}
                            {% endif %}
                            {% if c.route %}
                                <a href="{{ path(c.route, row.rp) }}">
                                    {{ label }}
                                </a>
                            {% else %}
                                {{ label }}
                            {% endif %}
                        {% endif %}

                    </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>

        {% endif %}
    </table>
{% endif %}
