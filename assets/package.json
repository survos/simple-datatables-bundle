{
  "name": "@survos/simple-datatables-bundle",
  "description": "integrate php and javascript helpers for Simple Datatables",
  "license": "MIT",
  "version": "1.0.4",
  "symfony": {
    "controllers": {
      "table": {
        "main": "src/controllers/table_controller.js",
        "webpackMode": "eager",
        "fetch": "lazy",
        "enabled": true,
        "autoimport": {
          "@survos/simple-datatables-bundle/style.css": true
        }
      },
      "ux": {
        "main": "src/controllers/ux_controller.js",
        "webpackMode": "eager",
        "fetch": "lazy",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.2.2",
      "simple-datatables": "^10.3.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "simple-datatables": "^10.3.0"
  }
}
